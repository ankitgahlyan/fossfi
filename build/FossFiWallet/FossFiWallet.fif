  // contracts/fossFi/fossFiWallet.tolk:554
  get_wallet_data() PROC:<{   	// 
    // 103: return FiWalletStore.fromCell(contract.getData())
    c4 PUSH                 	//  '20
    // 555: val store = lazy FiWalletStore.load()
    CTOS                    	//  lazyS
    // 556: val addrs = lazy store.addresses.load()
    LDGRAMS                 	//  store.jettonBalance lazyS
    LDREF                   	//  store.jettonBalance '25 lazyS
    NIP                     	//  store.jettonBalance lazyS
    LDREF                   	//  store.jettonBalance store.addresses lazyS
    LDREF                   	//  store.jettonBalance store.addresses '27 lazyS
    NIP                     	//  store.jettonBalance store.addresses lazyS
    PLDREF                  	//  store.jettonBalance store.addresses store.baseFiWalletCode
    SWAP                    	//  store.jettonBalance store.baseFiWalletCode store.addresses
    CTOS                    	//  store.jettonBalance store.baseFiWalletCode lazyS
    // 558: return
    LDSTDADDR               	//  store.jettonBalance store.baseFiWalletCode '40 lazyS
    NIP                     	//  store.jettonBalance store.baseFiWalletCode lazyS
    LDSTDADDR               	//  store.jettonBalance store.baseFiWalletCode '41 lazyS
    NIP                     	//  store.jettonBalance store.baseFiWalletCode lazyS
    LDSTDADDR               	//  store.jettonBalance store.baseFiWalletCode addrs.initialOwnerAddr lazyS
    LDREF                   	//  store.jettonBalance store.baseFiWalletCode addrs.initialOwnerAddr '43 lazyS
    NIP                     	//  store.jettonBalance store.baseFiWalletCode addrs.initialOwnerAddr lazyS
    LDREF                   	//  store.jettonBalance store.baseFiWalletCode addrs.initialOwnerAddr '44 lazyS
    NIP                     	//  store.jettonBalance store.baseFiWalletCode addrs.initialOwnerAddr lazyS
    PLDREF                  	//  store.jettonBalance store.baseFiWalletCode addrs.initialOwnerAddr addrs.trustedJettonAddrs
    // 561: minterAddress: addrs.trustedJettonAddrs.load().minterAddr
    CTOS                    	//  store.jettonBalance store.baseFiWalletCode addrs.initialOwnerAddr s
    LDSTDADDR               	//  store.jettonBalance store.baseFiWalletCode addrs.initialOwnerAddr '49 s
    LDOPTSTDADDR            	//  store.jettonBalance store.baseFiWalletCode addrs.initialOwnerAddr '49 '50 s
    NIP                     	//  store.jettonBalance store.baseFiWalletCode addrs.initialOwnerAddr '49 s
    LDOPTSTDADDR            	//  store.jettonBalance store.baseFiWalletCode addrs.initialOwnerAddr '49 '51 s
    NIP                     	//  store.jettonBalance store.baseFiWalletCode addrs.initialOwnerAddr '49 s
    LDOPTREF                	//  store.jettonBalance store.baseFiWalletCode addrs.initialOwnerAddr '49 '52 s
    NIP                     	//  store.jettonBalance store.baseFiWalletCode addrs.initialOwnerAddr '49 s
    ENDS                    	//  store.jettonBalance store.baseFiWalletCode addrs.initialOwnerAddr '49
    ROT                     	//  store.jettonBalance addrs.initialOwnerAddr '49 store.baseFiWalletCode
  }>
